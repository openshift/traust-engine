#!/usr/bin/env bash
# pre-push hook — full lint + unit tests before push.
# Bypass: git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push: uv not found — install uv, then run: make setup" >&2
  exit 1
fi

uv run ruff check .
uv run ruff format --check .
uv run pytest tests/ -q -m "not integration"
